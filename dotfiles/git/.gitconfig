# Shared git config. Your name/email live in ~/.gitconfig.local, which
# install/dotfiles.sh creates on first run and never commits.
[include]
    path = ~/.gitconfig.local
[core]
    editor = nvim
    excludesfile = ~/.gitignore_global
[init]
    defaultBranch = main
[pull]
    rebase = false
[color]
    ui = auto
[alias]
    co = checkout
    br = branch
    ci = commit
    st = status
    unstage = reset HEAD --
    last = log -1 HEAD
    logline = log --graph --oneline --decorate --all
